# CUDA toolkit descriptors, consumed by docker/build_dockers.sh and fed to
# docker/Dockerfile.cuda-toolkit.deps as build args.
#
# Adding a CUDA version: add the four URL/MD5 lines for it here (plus an EXTRA_ARGS
# line if the runfile needs one -- see below), then add its build block in
# build_dockers.sh. There is no new Dockerfile to write.
#
# MD5s are the upstream ones, from
#   https://developer.download.nvidia.com/compute/cuda/<version>/docs/sidebar/md5sum.txt
#
# Note the deliberate skew worth knowing about: the builder toolkit is installed from
# the 12.9.1 .run, while the RUNNER images derive from nvidia/cuda:12.9.0-devel-*.
# The runner tag and the toolkit patch level are not the same number.

CUDA_129_RUN_URL_x86_64=https://developer.download.nvidia.com/compute/cuda/12.9.1/local_installers/cuda_12.9.1_575.57.08_linux.run
CUDA_129_RUN_MD5_x86_64=a52d6c204bd4268627dfdab8bfeeb0d1
CUDA_129_RUN_URL_aarch64=https://developer.download.nvidia.com/compute/cuda/12.9.1/local_installers/cuda_12.9.1_575.57.08_linux_sbsa.run
CUDA_129_RUN_MD5_aarch64=824d4aea22be39358bb809b4f738488b
# --no-opengl-libs skips the driver's bundled GL/EGL/GLX user-mode libs, which this
# compile-only image has no use for. Still a valid runfile option on 12.9.
CUDA_129_RUN_EXTRA_ARGS=--no-opengl-libs

CUDA_134_RUN_URL_x86_64=https://developer.download.nvidia.com/compute/cuda/13.4.1/local_installers/cuda_13.4.1_linux.run
CUDA_134_RUN_MD5_x86_64=0a7ffad0f0d2f12592fe333dd3be580e
CUDA_134_RUN_URL_aarch64=https://developer.download.nvidia.com/compute/cuda/13.4.1/local_installers/cuda_13.4.1_linux_sbsa.run
CUDA_134_RUN_MD5_aarch64=22499618afa3a4d54021fdec2c644006
# 13.4's runfile rejects --no-opengl-libs outright ("Unknown option") rather than
# accepting it with a deprecation warning -- confirmed empirically on both x86_64 and
# aarch64, which failed identically at this step. Consistent with the CTK driver/GL
# decoupling: there is nothing bundled left to exclude, so the runfile dropped the
# flag instead of turning it into a no-op. Leave CUDA_134_RUN_EXTRA_ARGS unset
# (Dockerfile.cuda-toolkit.deps defaults it to empty).
