# Prebuilt NVIDIA libraries baked into the runner images: nvJPEG2000, nvTIFF, nvCOMP.
# Consumed by docker/build_dockers.sh, which turns these into build args for
# docker/Dockerfile.runner.
#
# These are the official redistributables on developer.download.nvidia.com. They need
# no credentials, and they are what the build uses unless a custom source is supplied
# (see docker/custom_libs.env, which is optional -- when it is absent, or its entries
# are empty, everything below applies).
#
# URLs are assembled as:
#   https://developer.download.nvidia.com/compute/<product>/redist/<pkg>/linux-<arch>/
#       <pkg>-linux-<arch>-<version>_cuda<major>-archive.tar.xz
# where <arch> is the NVIDIA artifact arch token: x86_64, or sbsa on aarch64.

NVJPEG2K_VERSION=0.12.0.58
NVTIFF_VERSION=0.9.0.86
NVCOMP_VERSION=6.0.0.12

# SHA256 of the two tarballs above, from NVIDIA's published redistrib_<version>.json
# manifest, keyed <artifact-arch>_cuda<major>. Only
# conda/recipes/libnvimgcodec/build.sh verifies against these today -- nothing else in
# this file's version set needs a hash pin.
NVTIFF_SHA256_x86_64_cuda12=f604bdc3100260ab36c5bb555a7b3dec5233361c5ede64caf8cc22c21b0a62d2
NVTIFF_SHA256_x86_64_cuda13=1752eea376c9e37eb5a6a837ba401756edb0f72d042bd337701707f350629351
NVTIFF_SHA256_sbsa_cuda12=248a62511d1416b29a699355e754d163994d5fb4d89395e898663af46bc28edf
NVTIFF_SHA256_sbsa_cuda13=1b75c11d78c0a3f50d45745e78bde5c9872ca05c6b2b9c9bcc59185a4a70c187
NVJPEG2K_SHA256_x86_64_cuda12=4fa571310cfd3a53c38bfad00da983e495422fb15d8376445bc0a28d5283ddb3
NVJPEG2K_SHA256_x86_64_cuda13=6536c8ad151394c3cdb4f35a24cc93d092934796c0900f848607d44432cc11de
NVJPEG2K_SHA256_sbsa_cuda12=b779f804a51ba641c17d49bc4d1c0e7aa4da95d540ee45e034640b7b2b660f21
NVJPEG2K_SHA256_sbsa_cuda13=a95330b69ac66ffeee1dd2a209c12a37074152a81660b850fb8d5fe4abfc2e82
